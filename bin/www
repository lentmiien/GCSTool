#!/usr/bin/env node

/**
 * Module dependencies.
 */
require('dotenv').config({ path: require('path').join(__dirname, '..', '.env') });
if (!process.env.SESSION_SECRET || !process.env.SESSION_SECRET.trim()) {
  throw new Error('SESSION_SECRET is required. Set it in the project .env file or process environment before starting GCSTool.');
}
require('../utils/runtimeDiagnostics').startRuntimeDiagnostics();

var {app, sessionMiddleware, lifecycle, closeSessionStore} = require('../app');
var debug = require('debug')('gcstool:server');
var http = require('http');
const { startTmpCleanup } = require('../utils/tmpCleaner');
const { installGracefulShutdown } = require('../utils/gracefulShutdown');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || '3000');
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

startTmpCleanup();

const workflowDatabase = require('../sequelize');
workflowDatabase.gcsDatabaseReady.then(() => {
  if (lifecycle.isStopping()) return;
  const { createService, startScheduler } = require('../services/workflows');
  startScheduler(createService(workflowDatabase), console, task => lifecycle.run(task));
}).catch(() => console.warn('Workflow scheduler could not start; check database readiness.'));

// Recover durable TARIC work after schema readiness; page GETs do not start jobs.
const taricDatabase = require('../sequelize');
taricDatabase.gcsDatabaseReady.then(() => {
  if (lifecycle.isStopping()) return;
  require('../services/irelandTaricWorker').createWorker(
    require('../services/irelandTaricStore').createStore(taricDatabase)
  ).start(task => lifecycle.run(task));
}).catch(() => console.warn('Ireland TARIC outbox could not start; check database readiness.'));

/**
 * Setup socket.io
 */

const io = require('../socket_io_controller').io(server, sessionMiddleware, lifecycle);
installGracefulShutdown({
  lifecycle,
  server,
  io,
  closeResources: () => Promise.all([
    closeSessionStore(),
    workflowDatabase.sequelize.close(),
    workflowDatabase.sequelize_tracker.close(),
    workflowDatabase.sequelize_dhl_compensation.close(),
  ]),
});

/**
 * Listen on provided port, on all network interfaces.
 */

server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
