extends layout

block content
  .auth-layout.account-password-layout
    section.auth-card(aria-labelledby='change-password-title')
      p.app-page-kicker Account security
      h1#change-password-title Change password
      if passwordChangeRequired
        .alert.alert-warning(role='alert')
          strong Password change required.
          |  An administrator issued your current temporary password. Choose a personal password before continuing.
      else
        p.text-muted Update the password used to sign in to your account.

      if error
        .alert.alert-danger(role='alert')= error

      form(method='post', action='/change-password')
        .form-group
          label(for='currentPassword') Current password
          input#currentPassword.form-control(
            type='password',
            name='currentPassword',
            maxlength='128',
            autocomplete='current-password',
            required,
            autofocus
          )
        .form-group
          label(for='newPassword') New password
          input#newPassword.form-control(
            type='password',
            name='newPassword',
            minlength='12',
            maxlength='128',
            autocomplete='new-password',
            aria-describedby='passwordHelp',
            required
          )
          small#passwordHelp.form-text.text-muted Use between 12 and 128 characters.
        .form-group
          label(for='confirmPassword') Confirm new password
          input#confirmPassword.form-control(
            type='password',
            name='confirmPassword',
            minlength='12',
            maxlength='128',
            autocomplete='new-password',
            required
          )
        button.btn.btn-primary.btn-block(type='submit') Save new password

      .auth-card-footer
        if !passwordChangeRequired
          a(href='/') Cancel and return home
        a(href='/logout') Sign out
