extends layout

block styles
  link(rel='stylesheet', href='/stylesheets/japanpost.css')

block content
  .jp-tool(data-csrf=japanPostCsrf)
    header.app-page-header
      div
        p.app-page-kicker Shipping reference
        h1 Japan Post limits
        p Import a country CSV to refresh shipping limits and keep a complete update history.
      a.btn.btn-outline-primary(href='/japan-post/database') Browse database
    .jp-columns
      section.jp-panel(aria-labelledby='jp-import-heading')
        p.app-page-kicker Country data
        h2#jp-import-heading Import Japan Post CSV
        p.jp-muted Upload the original UTF-8 CSV export. Every column is saved, including service flags, limits, customs forms, and delivery areas.
        form#jp-import-form(enctype='multipart/form-data')
          label(for='jp-csv') CSV file
          input#jp-csv.form-control(type='file', name='csvFile', accept='.csv,text/csv', required, aria-describedby='jp-file-help')
          p#jp-file-help.jp-muted.mt-2 Maximum 5 MB. One row per country code (国コード).
          button.btn.btn-primary(type='submit') Import CSV
        p#jp-import-status.mt-3(role='status', aria-live='polite') Choose a CSV file to begin.
        #jp-import-result(hidden)
          .jp-import-counts
            div
              strong#jp-added 0
              span New countries
            div
              strong#jp-updated 0
              span Updated
            div
              strong#jp-unchanged 0
              span Unchanged
          a.btn.btn-outline-primary.mt-3(href='/japan-post/database') View updated database
      section.jp-panel(aria-labelledby='jp-library-heading')
        p.app-page-kicker Saved reference
        h2#jp-library-heading Your country database
        p.jp-library-count
          strong#jp-country-count= overview.countries
          |  countries
        p.jp-muted
          | Last checked:#{' '}
          span#jp-last-checked= formatDate(overview.lastCheckedAt)
          |  JST
        hr
        h3.jp-subheading How imports update your records
        ul.jp-help-list
          li New country codes create their first saved version.
          li Changes to any column create a new version, preserving the previous data.
          li Identical values only update the last checked time.
          li Countries missing from the file remain in the database.
        p.jp-muted Each upload is checked in full before it is saved. All dates refer to when this app received the data, not its publication date.

block scripts
  script(src='/javascripts/japanpost.js')
