extends layout

block content
  .row
    .col
      h1 Shipping cost tables
      a.btn.btn-outline-primary.mb-3(href='/shipcost') Import / manage rates
  .row 
    .col 
      label(for='table_date') Rates as of (Japan date)
      input#table_date.form-control(type='date', value=rateToday.replace(/^(\d{4})(\d{2})(\d{2})$/, '$1-$2-$3'))
      button.btn.btn-primary.m-3(onclick="GenerateTables()") Update
      button.btn.btn-primary.m-3(onclick="DownloadCSV()") Download CSV
  .row 
    .col
      #controls
      #output

  pre#labels.hidden= JSON.stringify(labels)
  pre#data.hidden= JSON.stringify(data)
  pre#versions.hidden= JSON.stringify(versions)

  script(src='/javascripts/FileSaver.js', defer)
  script(src='/javascripts/shipcost-chart.js', defer)
  script(src='/javascripts/shipcostview.js', defer)
