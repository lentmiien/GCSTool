extends base
include mixins

block workflowContent
  section(aria-labelledby='my-tasks-title')
    h2#my-tasks-title My active tasks (#{tasks.length})
    p Only active tasks assigned to you are listed. Any one assigned staff member can complete a task.
    if !tasks.length
      .app-panel.app-empty-state
        h3 You're up to date
        p Your next assigned workflow task will appear here.
    each task in tasks
      article.app-panel.workflow-card
        header.workflow-card-heading
          div
            p.app-page-kicker= task.run.name
            h3= `${task.position + 1}. ${task.title}`
          a(href=`/workflows/runs/${task.run.id}`) Open workflow ↗
        p.workflow-text= task.description
        +variables(task.run.variables)
        +comments(comments.filter(item => item.runId === task.runId))
        +actionForm(task, task.run)
  if starters.length
    section.app-panel
      h2 Start a manual workflow
      p Complete the first task to start a new run.
      .workflow-library
        each def in starters
          a.workflow-library-item(href=`/workflows/definitions/${def.id}`)
            strong= def.name
            span= def.steps.find(step => !step.archived).title
