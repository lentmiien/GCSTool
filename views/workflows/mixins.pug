mixin csrf()
  input(type='hidden', name='_csrf', value=workflowCsrf)

mixin variableAudit(variable)
  small.workflow-variable-audit
    if variable.editedAt && variable.editedBy
      = `Edited by ${variable.editedBy} · ${formatWorkflowDate(variable.editedAt)} JST`
    else
      | Edit history unavailable

mixin variables(items)
  if items.length
    dl.workflow-variables(aria-label='Workflow variables')
      each variable in items
        div
          dt= variable.name
          dd.workflow-text= variable.value
          dd
            +variableAudit(variable)

mixin customRow(variable)
  .workflow-custom-row(data-custom-row=true)
    .workflow-variable-row
      label
        span Name
        input.form-control(data-custom-name=true, value=variable.name, maxlength=80, required=true)
      label
        span Value
        input.form-control(data-custom-value=true, value=variable.value, maxlength=1000, required=true)
      button.btn.btn-sm.btn-outline-secondary(type='button', data-remove-custom=true) Remove
    if variable.name
      +variableAudit(variable)

mixin customFields(items)
  .workflow-custom-fields
    div(data-custom-rows=true)
      each variable in items
        +customRow(variable)
    button.btn.btn-sm.btn-outline-secondary(type='button', data-add-custom=true, hidden=items.length >= 3) + Add variable
    template(data-custom-template=true)
      +customRow({ name: '', value: '' })
    input(type='hidden', name='custom', value=JSON.stringify(items.map(variable => ({ name: variable.name, value: variable.value }))))

mixin variableFields(items)
  .workflow-variable-fields
    .workflow-value-grid
      each variable in items.filter(variable => variable.required)
        .workflow-variable-field
          label
            span= `${variable.name} (required)`
            input.form-control(data-required-value=true, required=true, maxlength=1000, value=variable.value)
          +variableAudit(variable)
    input(type='hidden', name='values', value=JSON.stringify(items.filter(variable => variable.required).map(variable => variable.value)))
    +customFields(items.filter(variable => !variable.required))

mixin actionForm(task, run)
  form.workflow-action(method='post', action=`/workflows/runs/${run.id}/tasks/${task.id}`, data-variable-form=true)
    +csrf()
    input(type='hidden', name='revision', value=run.revision)
    +variableFields(run.variables)
    label(for=`comment-${task.id}`) Comment
    textarea.form-control(id=`comment-${task.id}`, name='comment', rows=3, maxlength=10000)= task.comment
    small= task.position > 0 ? 'Optional when completing. Explain the issue when returning a task.' : 'Optional handover note.'
    .workflow-actions
      button.btn.btn-primary(type='submit', name='action', value='complete', disabled=true, data-variable-submit=true) Complete task
      if task.position > 0
        button.btn.btn-outline-secondary(type='submit', name='action', value='reject', data-reject=true, disabled=true, data-variable-submit=true) Return task
    noscript Enable JavaScript to edit variables and submit this task.

mixin comments(items, label = 'Comments from other steps')
  if items.length
    details.workflow-comments
      summary= `${label} (${items.length})`
      each item in items
        article
          strong= `${item.position + 1}. ${item.title}`
          p.workflow-text
            each part in item.comment.split(/(https?:\/\/[^\s<>"']+)/g)
              if /^https?:\/\//.test(part)
                a(href=part, target='_blank', rel='noopener noreferrer')= part
              else
                = part
          small= `${item.commentBy || 'Staff'} · ${formatWorkflowDate(item.commentAt)} JST`

mixin stepEditor(step, users)
  fieldset.workflow-step-editor(data-step-row=true)
    legend Task
    input(type='hidden', data-field='id', value=step.id || '')
    label
      span Task title
      input.form-control(data-field='title', value=step.title, required=true, maxlength=160)
    label
      span Instructions
      textarea.form-control(data-field='description', required=true, rows=3, maxlength=10000)= step.description
    details.workflow-staff-picker(open=true)
      summary Staff who can complete this task
      .workflow-staff-options
        each user in users
          label.workflow-check
            input(type='checkbox', data-assignee=true, value=user.id, checked=step.assignees.includes(user.id))
            span= user.userid
      small No staff selected? The task will appear in admin analytics as unassigned.
    label.workflow-check
      input(type='checkbox', data-field='archived', checked=step.archived)
      span Archive this task (exclude from future runs)
    .workflow-actions
      button.btn.btn-sm.btn-outline-secondary(type='button', data-move='up') Move up
      button.btn.btn-sm.btn-outline-secondary(type='button', data-move='down') Move down
      if !step.id
        button.btn.btn-sm.btn-outline-danger(type='button', data-remove-row=true) Remove

mixin requiredEditor(variable)
  .workflow-variable-row(data-required-row=true)
    label
      span Required variable name
      input.form-control(data-field='name', value=variable.name, required=true, maxlength=80)
    label
      span Default value
      input.form-control(data-field='defaultValue', value=variable.defaultValue, maxlength=1000)
    button.btn.btn-sm.btn-outline-danger(type='button', data-remove-row=true) Remove
