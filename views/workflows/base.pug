extends ../layout

block styles
  link(rel='stylesheet', href='/stylesheets/workflows.css')

block content
  .workflow-page
    header.app-page-header
      div
        p.app-page-kicker Shared responsibilities
        h1 Workflows
        p One active step, shared staff, and a clear handover.
      nav.workflow-nav(aria-label='Workflow navigation')
        a.btn.btn-outline-secondary(href='/workflows', aria-current=currentPath === '/workflows' ? 'page' : undefined) My tasks
        a.btn.btn-outline-secondary(href='/workflows/definitions') Workflow library
        a.btn.btn-outline-secondary(href='/workflows/history') History
        if isWorkflowAdmin
          a.btn.btn-outline-secondary(href='/workflows/analytics') Analytics
          a.btn.btn-primary(href='/workflows/definitions/new') New workflow
    block workflowContent

block scripts
  script(src='/javascripts/workflows.js', defer=true)
