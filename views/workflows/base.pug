extends ../layout

block styles
  link(rel='stylesheet', href='/stylesheets/workflows.css')

block content
  .workflow-page
    header.app-page-header
      div
        h1 Workflows
      nav.workflow-nav(aria-label='Workflow navigation')
        a(href='/workflows', aria-current=currentPath === '/workflows' ? 'page' : undefined) My tasks
        a(href='/workflows/definitions', aria-current=currentPath.startsWith('/workflows/definitions') ? 'page' : undefined) Library
        a(href='/workflows/history', aria-current=currentPath === '/workflows/history' ? 'page' : undefined) History
        if isWorkflowAdmin
          a(href='/workflows/analytics', aria-current=currentPath === '/workflows/analytics' ? 'page' : undefined) Analytics
    block workflowContent

block scripts
  script(src='/javascripts/workflows.js', defer=true)
