extends ../layout

block content
  header.app-page-header
    div
      p.app-page-kicker Knowledge base
      h1 Review queue
      p Track library items that need a follow-up review.
    a.btn.btn-outline-secondary(href='/pmt') Back to library

  if logs.length > 0
    .app-panel
      .table-responsive
        table.table.table-striped
          thead
            tr
              th(scope='col') Entry
              th(scope='col') Details
              th(scope='col') Date
              th(scope='col') Action
          tbody
            each log in logs
              tr
                td
                  a(href=`/pmt/details/${log.entry_id}`)= log.entry_id
                td= log.details
                td= log.createdAt.toISOString().split('T')[0]
                td
                  form(method='post', action=`/pmt/log/${log.id}/complete`)
                    button.btn.btn-success.btn-sm(type='submit') Mark complete
  else
    .app-empty-state
      h2 Review queue clear
      p There are no flagged entries waiting for review.
