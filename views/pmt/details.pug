extends ../layout

block content
  header.app-page-header
    div
      p.app-page-kicker= entry.entry.type
      h1= entry.entry.title
      p Browse the current document, its history, and connected guidance.
    .app-page-actions
      if entry.entry.type === 'Template'
        button#copy-markdown.btn.pmt-copy-button(type='button', onclick='CopySelectedVersion(this)', aria-live='polite') Copy
      a.btn.btn-warning(href=`/pmt/edit/${entry.entry.id}`) Edit entry
      a.btn.btn-outline-secondary(href='/pmt') Back to library

  .row
    .col-lg-8
      section.app-panel.pmt-document-panel
        label(for='version') Document version
        select#version.form-control(name='version', onchange='UpdateVersion(this)')
          option(value=entry.entry.html, data-md=entry.entry.type === 'Template' ? entry.entry.content_md : undefined) Latest
          each v in entry.versions
            option(value=v.html, data-md=entry.entry.type === 'Template' ? v.content_md : undefined)= `Version ${v.version_number} (${v.createdAt.toISOString().split('T')[0]})`
        #content.pmt-entry-content!= entry.entry.html
    .col-lg-4.mt-3.mt-lg-0
      aside.app-panel.pmt-related-panel
        if entry.parents.length > 0
          h2 Parent policies
          .pmt-related-links
            each p in entry.parents
              button.btn.btn-outline-info.btn-sm(type='button', data-toggle='modal', data-target=`#m${p.parent_id}`)= entryMap[p.parent_id].title
        if entry.children.length > 0
          h2 Child documents
          .pmt-related-links
            each c in entry.children
              - const child = entryMap[c.child_id]
              button.btn.btn-outline-info.btn-sm(type='button', data-toggle='modal', data-target=`#m${c.child_id}`)
                span.pmt-document-type(class=`pmt-document-type--${child.type.toLowerCase()}`)= child.type
                = child.title
        if entry.parents.length > 0
          h2 Related documents
          if entry.relatedEntries.length > 0
            .pmt-related-links
              each related in entry.relatedEntries
                button.btn.btn-outline-info.btn-sm(type='button', data-toggle='modal', data-target=`#m${related.id}`)
                  span.pmt-document-type(class=`pmt-document-type--${related.type.toLowerCase()}`)= related.type
                  = related.title
          else
            p.text-muted No other documents under these parent policies.
        if entry.entry.type === 'Policy'
          h2 Create a child
          .pmt-related-links
            a.btn.btn-sm.btn-primary(href=`/pmt/create?type=Manual&parent=${entry.entry.id}`) + Manual
            a.btn.btn-sm.btn-primary(href=`/pmt/create?type=Template&parent=${entry.entry.id}`) + Template

      if entry.logs.length > 0
        section.app-panel.pmt-log-panel
          h2 Activity
          .table-responsive
            table.table.table-striped.table-sm
              thead
                tr
                  th(scope='col') Action
                  th(scope='col') By
                  th(scope='col') Details
                  th(scope='col') Date
              tbody
                each log in entry.logs
                  tr
                    td= log.action
                    td= log.action_by
                    td= log.details
                    td= log.createdAt.toISOString().split('T')[0]

  each ref in Object.keys(entryMap)
    - const ent = entryMap[ref]
    .modal.fade(id=`m${ref}`, tabindex='-1', role='dialog', aria-hidden='true')
      .modal-dialog.modal-lg(role='document')
        .modal-content
          .modal-header
            div
              h2.modal-title.h5= ent.title || `Entry ${ref}`
              if ent.type === 'Template'
                button.btn.btn-sm.pmt-copy-button.mt-2(type='button', data-md=ent.content_md, onclick="CopyThis(this, 'md')", aria-live='polite') Copy
            button.close(type='button', data-dismiss='modal', aria-label='Close')
              span(aria-hidden='true') ×
          .modal-body.pmt-entry-content!= ent.html
          .modal-footer
            a.btn.btn-sm.btn-primary(href=`/pmt/details/${ref}`) Open detail
            button.btn.btn-sm.btn-secondary(type='button', data-dismiss='modal') Close

block scripts
  script(src='/js/pmt/pmt.js')
  script(src='/js/pmt/details.js')
