extends layout

block styles
  link(rel='stylesheet', href='/css/personal_schedule.css')

block content
  - const year = Number.parseInt(show_year, 10)
  - const currentYear = (new Date()).getFullYear()
  - const previousYear = currentYear - 1
  - const nextYear = currentYear + 1
  - const daysInYear = new Date(year, 1, 29).getMonth() === 1 ? 366 : 365
  - const scheduleValues = Object.keys(schedule).map((key) => schedule[key])
  - const knownStatuses = ['work', 'telwork', '2hoff_m', '2hoff_e', 'halfoff_m', 'halfoff_e', 'off', 'holiday', 'vacation']
  - const numDaysOff = scheduleValues.filter((status) => status === 'off').length
  - const numUsedHolidays = scheduleValues.filter((status) => status === 'holiday').length
  - const numVacationDays = scheduleValues.filter((status) => status === 'vacation').length
  - const hasUnknownDays = scheduleValues.length < daysInYear || scheduleValues.some((status) => !knownStatuses.includes(status))
  - const totalDaysOff = total_days_off && total_days_off[show_year] !== undefined ? total_days_off[show_year] : '—'
  - const totalHolidays = total_holidays && total_holidays[show_year] !== undefined ? total_holidays[show_year] : '—'
  - const days = ['日', '月', '火', '水', '木', '金', '土']

  .personal-schedule-page
    header.personal-schedule-header
      p.personal-schedule-eyebrow Personal schedule
      h1= `年間スケジュール（${year}年） ${schedule_name}`

    nav.personal-schedule-year-nav(aria-label='表示する年を変更')
      a.personal-schedule-year-link(
        href=`/scheduler/${id}/personal_schedule?year=${previousYear}`,
        aria-label=`前年の${previousYear}年を表示`,
        aria-current=year === previousYear ? 'page' : undefined
      )
        span.personal-schedule-year-link__direction(aria-hidden='true') ‹ 前年
        strong= `${previousYear}年`
      a.personal-schedule-year-link(
        href=`/scheduler/${id}/personal_schedule?year=${currentYear}`,
        aria-label=`今年の${currentYear}年を表示`,
        aria-current=year === currentYear ? 'page' : undefined
      )
        span.personal-schedule-year-link__direction 今年
        strong= `${currentYear}年`
      a.personal-schedule-year-link(
        href=`/scheduler/${id}/personal_schedule?year=${nextYear}`,
        aria-label=`翌年の${nextYear}年を表示`,
        aria-current=year === nextYear ? 'page' : undefined
      )
        span.personal-schedule-year-link__direction(aria-hidden='true') 翌年 ›
        strong= `${nextYear}年`

    section.personal-schedule-calendar-panel(aria-labelledby='personal-schedule-calendar-heading')
      h2#personal-schedule-calendar-heading.sr-only= `${year}年の年間カレンダー`
      .personal-schedule-legend(role='list', aria-label='スケジュール区分')
        .personal-schedule-legend-item(role='listitem')
          span.personal-schedule-legend-swatch.personal-schedule-legend-swatch--work(aria-hidden='true')
          span.personal-schedule-legend-copy
            strong(lg_language='_work_') 仕事
        .personal-schedule-legend-item(role='listitem')
          span.personal-schedule-legend-swatch.personal-schedule-legend-swatch--telwork(aria-hidden='true')
          span.personal-schedule-legend-copy
            strong(lg_language='_telwork_') テレワーク
        .personal-schedule-legend-item(role='listitem')
          span.personal-schedule-legend-swatch.personal-schedule-legend-swatch--partial(aria-hidden='true')
          span.personal-schedule-legend-copy
            strong(lg_language='_work_nf_') 仕事（丸一日ではない）
        .personal-schedule-legend-item(role='listitem')
          span.personal-schedule-legend-swatch.personal-schedule-legend-swatch--off(aria-hidden='true')
          span.personal-schedule-legend-copy
            strong(lg_language='_day_off_') 定休
            small= `${numDaysOff} / ${totalDaysOff}`
        .personal-schedule-legend-item(role='listitem')
          span.personal-schedule-legend-swatch.personal-schedule-legend-swatch--holiday(aria-hidden='true')
          span.personal-schedule-legend-copy
            strong(lg_language='_holiday_') 祝日
            small= `${numUsedHolidays} / ${totalHolidays}`
        .personal-schedule-legend-item(role='listitem')
          span.personal-schedule-legend-swatch.personal-schedule-legend-swatch--vacation(aria-hidden='true')
          span.personal-schedule-legend-copy
            strong(lg_language='_vacation_') 休暇
            small= `${numVacationDays}`
        if hasUnknownDays
          .personal-schedule-legend-item(role='listitem')
            span.personal-schedule-legend-swatch.personal-schedule-legend-swatch--unknown(aria-hidden='true')
            span.personal-schedule-legend-copy
              strong 未設定

      .personal-schedule-calendar-scroll(tabindex='0', aria-label='年間カレンダー。横方向にスクロールできます。')
        svg.personal-schedule-calendar(
          width='1240',
          height='1600',
          viewBox='0 0 1240 1600',
          fill='none',
          xmlns='http://www.w3.org/2000/svg',
          aria-labelledby='personal-schedule-svg-title personal-schedule-svg-description'
        )
          title#personal-schedule-svg-title= `${year}年 ${schedule_name}の年間スケジュール`
          desc#personal-schedule-svg-description 日付を選択すると、その日のスケジュールを変更できます。
          - let month = 0
          while month < 12
            - const xOffset = (month % 3) * 420
            - const yOffset = Math.floor(month / 3) * 400
            g.personal-schedule-month
              rect.personal-schedule-month__surface(x=xOffset, y=yOffset + 4, width='400', height='388', rx='18', ry='18')
              text.personal-schedule-month__title(
                x=xOffset + 200,
                y=yOffset + 31,
                dominant-baseline='middle',
                text-anchor='middle'
              )= `${month + 1}月`
              - let dayIndex = 0
              while dayIndex < 7
                - const weekdayClass = dayIndex === 0 ? 'personal-schedule-weekday--sunday' : dayIndex === 6 ? 'personal-schedule-weekday--saturday' : ''
                text.personal-schedule-weekday(
                  class=weekdayClass,
                  x=xOffset + 30 + dayIndex * 56,
                  y=yOffset + 67,
                  dominant-baseline='middle',
                  text-anchor='middle'
                )= days[dayIndex]
                - dayIndex++
              - let date = new Date(year, month, 1)
              - let weekIndex = 0
              while date.getMonth() === month
                - const weekday = date.getDay()
                - const dateKey = `${year}-${month}-${date.getDate()}`
                - const scheduleStatus = schedule[dateKey] || ''
                - const dateClass = weekday === 0 ? 'personal-schedule-day--sunday' : weekday === 6 ? 'personal-schedule-day--saturday' : ''
                - const dayX = xOffset + 5 + weekday * 56
                - const dayY = yOffset + 86 + weekIndex * 49
                g.personal-schedule-day(
                  id=`day_${year}_${month + 1}_${date.getDate()}`,
                  class=dateClass,
                  role='button',
                  tabindex='0',
                  data-year=year,
                  data-month=month + 1,
                  data-date=date.getDate(),
                  data-status=scheduleStatus,
                  data-staff=id,
                  aria-label=`${year}年${month + 1}月${date.getDate()}日のスケジュールを編集`,
                  onclick='ClickOnScheduleDay(this)',
                  onkeydown='HandleScheduleDayKeydown(event)'
                )
                  rect.personal-schedule-day__cell(x=dayX, y=dayY, width='50', height='45', rx='9', ry='9')
                  text.personal-schedule-day__number(
                    x=dayX + 25,
                    y=dayY + 23,
                    dominant-baseline='middle',
                    text-anchor='middle'
                  )= date.getDate()
                - date = new Date(year, month, date.getDate() + 1)
                if date.getDay() === 0
                  - weekIndex++
            - month++

block scripts
  script(src='/javascripts/editschedule.js')
