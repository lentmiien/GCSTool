extends layout

mixin cell(value, previous, recent, className)
  - const changed = previous !== null && value !== previous
  td(class=[className, recent && changed ? 'jp-recent-cell' : ''])
    if changed
      strong.jp-changed(title=`Previously: ${previous}`)= value
    else
      span= value

block styles
  link(rel='stylesheet', href='/stylesheets/japanpost.css')

block content
  - const renderedAt = Date.now()
  .jp-tool
    header.app-page-header
      div
        p.app-page-kicker Shipping reference
        h1 Japan Post database
        p Latest imported limits for each country. Bold values changed from the immediately preceding version.
      a.btn.btn-outline-primary(href='/japan-post') Import CSV
    section.jp-panel
      form.jp-filters(method='get', action='/japan-post/database')
        div
          label(for='jp-search') Country or code
          input#jp-search.form-control(type='search', name='q', value=filters.q || '', placeholder='Name or country code')
        div
          label(for='jp-from') Updated from (JST)
          input#jp-from.form-control(type='date', name='from', value=filters.from || '')
        div
          label(for='jp-to') Updated through (JST)
          input#jp-to.form-control(type='date', name='to', value=filters.to || '')
        label.jp-check
          input(type='checkbox', name='changed', value='1', checked=filters.changed === '1')
          |  Has update history
        label.jp-check
          input(type='checkbox', name='stale', value='1', checked=filters.stale === '1')
          |  Not checked today
        button.btn.btn-primary(type='submit') Filter
        a.btn.btn-outline-secondary(href='/japan-post/database') Reset
      p.jp-muted.mt-3= `${rows.length} countries · Japan time · Weights in kg; lengths converted from cm to m. Length + girth includes the circumference around the parcel.`
      p.jp-muted Column colors identify shipping methods. Gold highlights mark additions and changes in the last 7 days. New countries highlight the full row; later versions highlight only changed cells. Availability follows the CSV handling flags.
      if rows.length
        .table-responsive
          table.table.jp-table.jp-database
            thead
              tr
                th(scope='col', rowspan='2') Code
                th(scope='col', rowspan='2') Country
                each group in rows[0].limits
                  th.jp-method-heading(scope='colgroup', colspan='3', class=group.className)= group.label
                th.jp-date-cell(scope='col', rowspan='2') Last updated
                th.jp-date-cell(scope='col', rowspan='2') Last checked
              tr
                each group in rows[0].limits
                  each label in ['Weight', 'Length', 'Length + girth']
                    th.jp-measurement(scope='col', class=group.className)= label
            tbody
              each row in rows
                - const age = renderedAt - new Date(row.detectedAt).getTime()
                - const recent = age >= 0 && age <= 7 * 24 * 60 * 60 * 1000
                tr(class=recent && !row.previous ? 'jp-recent-row' : '')
                  td
                    a(href=`/japan-post/countries/${row.countryCode}`, aria-label=`View ${row.data['国名（英語）']} details`)= row.countryCode
                  +cell(row.data['国名（英語）'], row.previous ? row.previous['国名（英語）'] : null, recent, 'jp-country-cell')
                  each group, index in row.limits
                    - const oldGroup = row.previousLimits && row.previousLimits[index]
                    if group.status !== 'Available'
                      - const changed = oldGroup && oldGroup.status !== group.status
                      td.jp-unavailable(colspan='3', class=[group.className, recent && changed ? 'jp-recent-cell' : ''])
                        if changed
                          strong.jp-changed(title=`Previously: ${oldGroup.status}`)= group.status
                        else
                          span= group.status
                    else
                      each value, fieldIndex in group.values
                        +cell(value, oldGroup ? (oldGroup.status === 'Available' ? oldGroup.values[fieldIndex] : oldGroup.status) : null, recent, `jp-measurement ${group.className}`)
                  td.jp-date-cell= formatDate(row.detectedAt)
                  td.jp-date-cell= formatDate(row.lastCheckedAt)
      else
        p No imported countries match these filters.
        a(href='/japan-post') Import a Japan Post CSV to add country data.
